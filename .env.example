DATABASE_URL="file:./dev.db"
# Password for the staff dashboard at /admin (at least 12 characters)
ADMIN_PASSWORD="change-me"
# Random string, 32+ characters, that signs the admin cookie (openssl rand -hex 32)
SESSION_SECRET="replace-with-a-long-random-string"
# Optional: IANA timezone of the venue (defaults to America/New_York)
# NEXT_PUBLIC_RESTAURANT_TIMEZONE="America/New_York"
# Optional: header your host sets to the real client IP, used for rate limiting
# (Vercel: "x-real-ip", Cloudflare: "cf-connecting-ip"). Defaults to the last X-Forwarded-For hop.
# TRUSTED_IP_HEADER="x-real-ip"
